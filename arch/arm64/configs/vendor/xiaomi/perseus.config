CONFIG_BUILD_ARM64_DT_OVERLAY=y
CONFIG_HARDEN_BRANCH_PREDICTOR=n
CONFIG_MITIGATE_SPECTRE_BRANCH_HISTORY=n
CONFIG_KEXEC=y
CONFIG_TOUCHSCREEN_ST_FTS_V521=y
CONFIG_TOUCHSCREEN_FTS=y
CONFIG_TOUCHSCREEN_FTS_POWER_SUPPLY=y
CONFIG_FINGERPRINT_FPC_TEE=y
CONFIG_FINGERPRINT_GOODIX_TA=y
CONFIG_USE_ROHM_BU64753=y
CONFIG_IDT_P9220=y
CONFIG_BCM_GPS_SPI_DRIVER=y
CONFIG_HALLS=y
CONFIG_SND_SOC_TAS2557=y
CONFIG_TAS2557_CODEC=y
CONFIG_TAS2557_MISC=y
CONFIG_TAS2557_REGMAP=y
CONFIG_MACH_XIAOMI_E5=y

# Kali NetHunter Support
# System V IPC & General Setup
CONFIG_SYSVIPC=y

# Loadable Module Support
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y
CONFIG_MODVERSIONS=y

# Networking Support (Essential for NetHunter)
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_BRIDGE=y
CONFIG_VLAN_8021Q=y
CONFIG_LLC=y

# Wireless Networking (802.11)
CONFIG_CFG80211=y
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211=y
CONFIG_MAC80211_MESH=y

# Bluetooth Support
CONFIG_BT=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_HIDP=y
CONFIG_BT_HCIUART=y

# USB Support (Critical for NetHunter)
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y
CONFIG_USB_MON=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_ACM=y
CONFIG_USB_STORAGE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_OBEX=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_F_HID=y

# HID Support
CONFIG_HID=y
CONFIG_UHID=y

# TUN/TAP Support
CONFIG_TUN=y

# Wireless Drivers (External USB Adapters)
# Note: ATH9K_HTC removed due to compilation errors in upstream driver
CONFIG_ATH10K=m
CONFIG_RTL8192CU=m
CONFIG_RT2800USB=m

# Network Packet Capture
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_STATE=y

# ============================================================================
# Multi-Boot Support: Android + NetHunter + SailfishOS + Ubuntu Touch
# ============================================================================

# Security Frameworks (Both enabled, switchable at boot)
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y

# SELinux (Required for Android and SailfishOS)
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_BOOTPARAM_VALUE=1
CONFIG_SECURITY_SELINUX_DISABLE=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_SECURITY_SELINUX_AVC_STATS=y
CONFIG_SECURITY_SELINUX_CHECKREQPROT_VALUE=1

# AppArmor (Required for Ubuntu Touch)
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_APPARMOR_HASH=y
CONFIG_SECURITY_APPARMOR_HASH_DEFAULT=y
CONFIG_SECURITY_APPARMOR_BOOTPARAM_VALUE=0

# Default to SELinux (Android), switch to AppArmor via boot param for Ubuntu Touch
CONFIG_DEFAULT_SECURITY_SELINUX=y
# CONFIG_DEFAULT_SECURITY_APPARMOR is not set
CONFIG_DEFAULT_SECURITY="selinux"

# LSM ordering
CONFIG_LSM="lockdown,yama,loadpin,safesetid,integrity,selinux,smack,tomoyo,apparmor"

# ============================================================================
# Namespaces & Container Support (Ubuntu Touch via Halium/LXC)
# ============================================================================
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUP_NS=y

# CGroups (Container isolation and resource management)
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CPUSETS=y
CONFIG_PROC_PID_CPUSET=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_PAGE_COUNTER=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_RT_GROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_BLK_CGROUP=y

# ============================================================================
# Console/TTY Support (Ubuntu Touch Upstart requirement)
# ============================================================================
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VT_CONSOLE_SLEEP=y
CONFIG_HW_CONSOLE=y
CONFIG_UNIX98_PTYS=y

# ============================================================================
# IPC Features (SailfishOS and Ubuntu Touch)
# ============================================================================
CONFIG_POSIX_MQUEUE=y
CONFIG_POSIX_MQUEUE_SYSCTL=y
# CONFIG_SYSVIPC=y already enabled above

# ============================================================================
# Input Subsystem (SailfishOS vibrator via force feedback)
# ============================================================================
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_EVBUG=y
CONFIG_INPUT_FF_MEMLESS=y

# Disable deprecated Android timed output (conflicts with FF_MEMLESS)
# CONFIG_ANDROID_TIMED_OUTPUT is not set

# ============================================================================
# Filesystem Support (Image mounting for Ubuntu Touch)
# ============================================================================

# FUSE for userspace filesystems
CONFIG_FUSE_FS=y

# Loop device for image mounting
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=16

# OverlayFS for multi-boot root switching
CONFIG_OVERLAY_FS=y

# SquashFS (common in mobile Linux distributions)
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_FILE_CACHE=y
CONFIG_SQUASHFS_DECOMP_MULTI_PERCPU=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_4K_DEVBLK_SIZE=y
CONFIG_SQUASHFS_EMBEDDED=y

# Device Mapper (for encrypted containers and image mapping)
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_BLK_DEV_DM_BUILTIN=y
CONFIG_DM_CRYPT=y
CONFIG_DM_SNAPSHOT=y
CONFIG_DM_THIN_PROVISIONING=y
CONFIG_DM_VERITY=y

# ============================================================================
# Cryptographic Support (All OSes)
# ============================================================================
CONFIG_CRYPTO=y
CONFIG_CRYPTO_ALGAPI=y
CONFIG_CRYPTO_AEAD=y
CONFIG_CRYPTO_BLKCIPHER=y
CONFIG_CRYPTO_HASH=y
CONFIG_CRYPTO_RNG=y
CONFIG_CRYPTO_MANAGER=y
CONFIG_CRYPTO_NULL=y
CONFIG_CRYPTO_WORKQUEUE=y
CONFIG_CRYPTO_CCM=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_CTR=y
CONFIG_CRYPTO_CTS=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_AES_ARM64=y
CONFIG_CRYPTO_AES_ARM64_CE=y
CONFIG_CRYPTO_AES_ARM64_CE_BLK=y
CONFIG_CRYPTO_AES_ARM64_NEON_BLK=y

# ============================================================================
# Android Compatibility Adjustments
# ============================================================================

# Disable paranoid network (allows Ubuntu Touch network access)
# Note: This may affect some legacy Android apps that expect it
# CONFIG_ANDROID_PARANOID_NETWORK is not set

# Keep Android low memory killer
CONFIG_ANDROID_LOW_MEMORY_KILLER=y

# Android Binder IPC (still needed by Android and SailfishOS via libhybris)
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# ============================================================================
# Multi-Boot Kernel Switching (via kexec)
# ============================================================================
# CONFIG_KEXEC=y already enabled above
CONFIG_KEXEC_FILE=y
CONFIG_KEXEC_VERIFY_SIG=n

# ============================================================================
# Additional Filesystem Support
# ============================================================================
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_EXT4_ENCRYPTION=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_FS_ENCRYPTION=y
CONFIG_VFAT_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# ============================================================================
# Audit Framework (Required by SELinux and AppArmor)
# ============================================================================
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y

# ============================================================================
# Network Security (NetHunter additions already present)
# ============================================================================
# All CONFIG_NETFILTER_* options already configured above

# ============================================================================
# Debugging Support (Can be disabled for production)
# ============================================================================
CONFIG_MAGIC_SYSRQ=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_PANIC_TIMEOUT=5

# ============================================================================
# END Multi-Boot Configuration
# ============================================================================
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_BINFMT_MISC=y
CONFIG_FANOTIFY=y
CONFIG_AUTOFS4_FS=y
CONFIG_FHANDLE=y
CONFIG_DUMMY=n
