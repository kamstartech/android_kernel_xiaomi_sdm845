# Kali NetHunter Kernel Configuration
# Required kernel options for NetHunter functionality

# Network packet filtering framework (Netfilter)
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_NAT=y

# Wireless extensions and cfg80211
CONFIG_WIRELESS_EXT=y
CONFIG_WEXT_PRIV=y
CONFIG_CFG80211=y
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211=y
CONFIG_MAC80211_HAS_RC=y

# Packet socket and raw sockets
CONFIG_PACKET=y
CONFIG_UNIX=y

# TUN/TAP support
CONFIG_TUN=y

# USB Gadget support for HID attacks
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_EEM=y

# HID support
CONFIG_HID=y
CONFIG_UHID=y
CONFIG_HID_GENERIC=y

# Bluetooth HID
CONFIG_BT=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_HIDP=y

# Kexec support (already enabled but ensuring it's set)
CONFIG_KEXEC=y
CONFIG_KEXEC_CORE=y

# Additional networking
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y

# PPP support for VPN
CONFIG_PPP=y
CONFIG_PPP_ASYNC=y
CONFIG_PPP_DEFLATE=y
CONFIG_PPP_BSDCOMP=y
CONFIG_PPP_MPPE=y
CONFIG_PPPOE=y
CONFIG_PPTP=y
CONFIG_PPPOL2TP=y

# Kernel modules support
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y

# IEEE 802.11 for monitor mode
CONFIG_MAC80211_MESH=y

# Bridge support
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y

# VLAN support
CONFIG_VLAN_8021Q=y

# Crypto support
CONFIG_CRYPTO=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y

# File systems
CONFIG_FUSE_FS=y
CONFIG_OVERLAY_FS=y

# Security - Allow for custom policies
# CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_LSM="lockdown,yama,loadpin,safesetid,integrity,selinux"

# --- Mainline Backports ---
# Modern Networking (WireGuard)
CONFIG_WIREGUARD=y

# Modern Congestion Control (BBRv2)
CONFIG_TCP_CONG_BBR2=y
CONFIG_DEFAULT_TCP_CONG="bbr2"

# Modern Storage (F2FS)
CONFIG_F2FS_FS=y
CONFIG_F2FS_STAT_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_F2FS_FS_SECURITY=y
